{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, courses, highlights
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 col-sm-3 col-md-3 text-center date-column cv-education-meta">
          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}

          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}

          {% if start_date != '' %}
            {% assign startDate = start_date | strip %}
            {% assign endDate = end_date | strip | default: 'Present' %}
            {% if endDate == 'present' %}
              {% assign endDate = 'Present' %}
            {% endif %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              {% assign study_type = study_type | strip %}
              {% if date %}
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                  </td>
                </tr>
              {% endif %}
              {% if study_type != '' %}
                <tr>
                  <td>
                    <p class="cv-education-degree">{{ study_type }}</p>
                  </td>
                </tr>
              {% endif %}
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% if location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-12 col-sm-9 col-md-9 mt-2 mt-md-0 cv-education-body">
          {% if entry.institution %}
            <h6 class="cv-education-school ml-1">
              {% if entry.url %}
                <a href="{{ entry.url }}">{{ entry.institution }}</a>
              {% else %}
                {{ entry.institution }}
              {% endif %}
              {% if entry.area %}
                <span>{{ entry.area }}</span>
              {% endif %}
            </h6>
          {% endif %}

          {% if entry.courses or entry.highlights %}
            <div class="cv-education-details ml-1">
              {% for item in entry.courses %}
                {% assign item_text = item | markdownify | remove: '<p>' | remove: '</p>' | strip %}
                <p>{{ item_text }}</p>
              {% endfor %}
              {% for item in entry.highlights %}
                {% assign item_text = item | markdownify | remove: '<p>' | remove: '</p>' | strip %}
                {% if item_text contains ':' %}
                  {% assign item_label = item_text | split: ':' | first | strip %}
                  {% assign item_value = item_text | remove_first: item_label | remove_first: ':' | strip %}
                  <p>
                    <span class="cv-education-detail-label">{{ item_label }}:</span> {{ item_value }}
                  </p>
                {% else %}
                  <p>{{ item_text }}</p>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
