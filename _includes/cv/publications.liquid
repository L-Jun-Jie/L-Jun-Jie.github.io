{% comment %}
  Unified publications entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        {% capture pub_date %}
          {% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}
        {% endcapture %}
        {% capture author_line %}
          {% if entry.authors %}
            {% assign self_name = site.first_name | append: ' ' | append: site.last_name %}
            {%- for author in entry.authors -%}
              {% assign author_name = author.name | default: author | strip %}
              {%- unless forloop.first -%}
                {%- if forloop.last and forloop.length == 2 -%}
                  {{ ' and ' }}
                {%- elsif forloop.last -%}
                  {{ ', and ' }}
                {%- else -%}
                  {{ ', ' }}
                {%- endif -%}
              {%- endunless -%}
              {% if author_name == self_name %}
                <strong><u>{{ author_name }}</u></strong>
              {% else %}
                {{ author_name }}
              {% endif %}
            {%- endfor -%}
          {% elsif entry.author %}
            {{ entry.author }}
          {% endif %}
        {% endcapture %}
        {% assign author_line = author_line | strip %}

        {% if pub_date != '' %}
          <div class="col-xs-2 col-sm-2 col-md-2 text-center">
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{- pub_date | split: '-' | slice: 0, 1 | join: '' -}}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
            {% if entry.url %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                <a href="{{ entry.url }}">{{ entry.title | default: entry.name }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
            {% endif %}

            {% if author_line != '' %}
              <div class="author ml-1 ml-md-4">{{ author_line }}</div>
            {% endif %}

            {% if entry.publisher %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
                <em>{{ entry.publisher }}</em>
              </h6>
            {% endif %}

            {% if entry.note %}
              <div class="publication-note ml-1 ml-md-4">{{ entry.note | strip }}</div>
            {% endif %}

            {% if entry.url or entry.code %}
              <div class="links ml-1 ml-md-4 mt-2">
                {% if entry.url %}
                  <a href="{{ entry.url }}" class="btncv" role="button" target="_blank" rel="noopener noreferrer">Paper</a>
                {% endif %}
                {% if entry.code %}
                  <a href="{{ entry.code }}" class="btncv" role="button" target="_blank" rel="noopener noreferrer">Code</a>
                {% endif %}
              </div>
            {% endif %}

            {% if entry.summary %}
              <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}
          </div>
        {% else %}
          <div class="col-xs-12 col-sm-12 col-md-12">
            {% if entry.url %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                <a href="{{ entry.url }}">{{ entry.title | default: entry.name }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">{{ entry.title }}</h6>
            {% endif %}

            {% if author_line != '' %}
              <div class="author ml-1 ml-md-4">{{ author_line }}</div>
            {% endif %}

            {% if entry.publisher %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">
                <em>{{ entry.publisher }}</em>
              </h6>
            {% endif %}

            {% if entry.note %}
              <div class="publication-note ml-1 ml-md-4">{{ entry.note | strip }}</div>
            {% endif %}

            {% if entry.url or entry.code %}
              <div class="links ml-1 ml-md-4 mt-2">
                {% if entry.url %}
                  <a href="{{ entry.url }}" class="btncv" role="button" target="_blank" rel="noopener noreferrer">Paper</a>
                {% endif %}
                {% if entry.code %}
                  <a href="{{ entry.code }}" class="btncv" role="button" target="_blank" rel="noopener noreferrer">Code</a>
                {% endif %}
              </div>
            {% endif %}

            {% if entry.summary %}
              <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
